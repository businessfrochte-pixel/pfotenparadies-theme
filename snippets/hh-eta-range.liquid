{%- comment -%}
  Liefert "MIN-MAX" Werktage für ein Produkt. Reihenfolge: Produktfelder custom.lieferzeit_min/max → Tag lieferzeit-MIN-MAX → zentrale Angabe (hh-config).
{%- endcomment -%}
{%- liquid
  capture dmin
    render 'hh-config', key: 'delivery_min'
  endcapture
  capture dmax
    render 'hh-config', key: 'delivery_max'
  endcapture
  assign dmin = dmin | strip
  assign dmax = dmax | strip
  if product != blank
    for tag in product.tags
      if tag contains 'lieferzeit-'
        assign parts = tag | remove: 'lieferzeit-' | split: '-'
        assign dmin = parts[0]
        assign dmax = parts[1]
      endif
    endfor
    if product.metafields.custom.lieferzeit_min != blank and product.metafields.custom.lieferzeit_max != blank
      assign dmin = product.metafields.custom.lieferzeit_min.value
      assign dmax = product.metafields.custom.lieferzeit_max.value
    endif
  endif
  echo dmin | append: '-' | append: dmax
-%}
