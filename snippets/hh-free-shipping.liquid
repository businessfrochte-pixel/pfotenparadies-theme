{%- liquid
  capture threshold
    render 'hh-config', key: 'free_shipping_cents'
  endcapture
  assign threshold = threshold | strip | plus: 0
  assign total = cart.total_price
  assign remaining = threshold | minus: total
  assign pct = 0
  if threshold > 0
    assign pct = total | times: 100 | divided_by: threshold
  endif
  if pct > 100
    assign pct = 100
  endif
-%}
{%- comment -%} Nachtwerk (19.10.2026): eigenes Versandprofil, Schwelle 49 € – Balken bei jedem Warenkorb zeigen. {%- endcomment -%}
{%- if threshold > 0 and cart.item_count > 0 and remaining <= threshold -%}
  <div class="hh-fs{% if remaining <= 0 %} hh-fs--done{% endif %}" role="status">
    {%- if remaining > 0 -%}
      <p>Noch <strong>{{ remaining | money }}</strong> bis zum <strong>kostenlosen Versand</strong></p>
      <div class="hh-fs__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></div>
    {%- else -%}
      <p><strong>Super – dein Versand ist kostenlos!</strong></p>
    {%- endif -%}
  </div>
{%- endif -%}
