{%- liquid
  capture range
    render 'hh-eta-range', product: product
  endcapture
  assign parts = range | strip | split: '-'
  assign dmin = parts[0]
  assign dmax = parts[1]
-%}
<p class="hh-eta" data-hh-eta data-min="{{ dmin }}" data-max="{{ dmax }}">{% render 'hh-icon', name: 'truck' %}<span>Lieferung voraussichtlich <strong data-hh-eta-text>in {{ dmin }}–{{ dmax }} Werktagen</strong><small>nach {% render 'hh-config', key: 'ship_to' %}, mit Sendungsverfolgung</small></span></p>
