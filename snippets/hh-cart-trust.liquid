{%- liquid
  assign cmin = 0
  assign cmax = 0
  for item in cart.items
    capture range
      render 'hh-eta-range', product: item.product
    endcapture
    assign range = range | strip
    assign parts = range | split: '-'
    assign e_min = parts[0] | plus: 0
    assign e_max = parts[1] | plus: 0
    if e_min > cmin
      assign cmin = e_min
    endif
    if e_max > cmax
      assign cmax = e_max
    endif
  endfor
-%}
<div class="hh hh-ctrust">
  {%- if cart.item_count > 0 -%}
    <p class="hh-ctrust__eta" data-hh-eta data-min="{{ cmin }}" data-max="{{ cmax }}">Voraussichtliche Lieferung innerhalb Deutschlands: <strong data-hh-eta-text>in {{ cmin }}–{{ cmax }} Werktagen</strong></p>
    <p class="hh-ctrust__ship">Versand in Deutschland {% render 'hh-config', key: 'shipping_fee' %}, ab {% render 'hh-config', key: 'free_shipping' %} kostenlos. Wir liefern weltweit – <a href="/pages/versand-lieferung">Kosten für andere Länder</a>.</p>
  {%- endif -%}
  <ul>
    <li>Als Gast bestellen</li>
    <li>Gesetzliches Widerrufsrecht</li>
  </ul>
  {% render 'hh-payment-icons' %}
</div>
