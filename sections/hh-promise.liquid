{%- comment -%}
  PfotenParadies – Warum bei uns (JARVIS). Zweck: Beantwortet die Kundenfrage "Warum hier kaufen?" mit drei
  überprüfbaren Gründen (Auswahl mit vollständigen Angaben, Größe, persönliche Beratung). Keine Siegel, keine Superlative.
  Nur Aussagen eintragen, die der Shop tatsächlich einhält.
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--full-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-promise" aria-labelledby="hh-promise-{{ section.id }}">
    <div class="hh-promise__inner">
      <div class="hh-promise__head hh-reveal">
        {%- if section.settings.eyebrow != blank -%}<p class="hh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="hh-promise-{{ section.id }}" class="hh-promise__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="hh-promise__lead">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <ol class="hh-promise__list">
        {%- for block in section.blocks -%}
          <li class="hh-promise__item hh-reveal" {{ block.shopify_attributes }}>
            <span class="hh-promise__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <h3 class="hh-promise__h">{{ block.settings.title | escape }}</h3>
            <div class="hh-promise__text">{{ block.settings.text }}</div>
            {%- if block.settings.link_label != blank -%}
              <a class="hh-promise__link" href="{{ block.settings.link | default: '/pages/contact' }}">{{ block.settings.link_label | escape }}{% render 'hh-icon', name: 'arrow' %}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "PP Warum bei uns",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Warum PfotenParadies" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Weniger Auswahl. Mehr Gewissheit." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Grund",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "richtext", "id": "text", "label": "Text", "info": "Nur nachprüfbare Aussagen." },
        { "type": "text", "id": "link_label", "label": "Link-Text" },
        { "type": "url", "id": "link", "label": "Link-Ziel" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "PP Warum bei uns" }]
}
{% endschema %}
