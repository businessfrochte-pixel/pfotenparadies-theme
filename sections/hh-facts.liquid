{%- comment -%}
  PfotenParadies – Fakten statt Vertrauensbehauptungen (JARVIS). Werte kommen zentral aus snippets/hh-config.liquid.
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-facts" aria-label="Lieferung, Versand, Rückgabe und Beratung">
    <ul>
      <li>{% render 'hh-icon', name: 'truck' %}<span><strong>Lieferung in {% render 'hh-config', key: 'delivery' %}</strong>Das voraussichtliche Datum steht bei jedem Produkt.</span></li>
      <li>{% render 'hh-icon', name: 'euro' %}<span><strong>Versand {% render 'hh-config', key: 'shipping_fee' %}</strong>Ab {% render 'hh-config', key: 'free_shipping' %} Bestellwert kostenlos.</span></li>
      <li>{% render 'hh-icon', name: 'return' %}<span><strong>14 Tage Rückgabe</strong><a class="hh-link" href="/pages/rueckgabe-widerruf">So funktioniert es</a></span></li>
      <li>{% render 'hh-icon', name: 'chat' %}<span><strong>Beratung vor dem Kauf</strong><a class="hh-link" href="/pages/contact">Schreib uns</a> – Antwort {% render 'hh-config', key: 'reply_time' %}.</span></li>
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "PP Fakten",
  "class": "hh-section",
  "settings": [
    { "type": "paragraph", "content": "Lieferzeit, Versandkosten und Antwortzeit werden zentral in snippets/hh-config.liquid gepflegt." },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "PP Fakten" }]
}
{% endschema %}
