{%- comment -%}
  Nachtwerk – Kaufgrund bei uns als prüfbare Fakten (JARVIS). Nur Aussagen, die der Shop tatsächlich einlöst.
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-facts" aria-label="Warum bei Nachtwerk bestellen">
    <ul>
      <li>{% render 'hh-icon', name: 'moon' %}<span><strong>Nach Störquelle sortiert</strong>Licht, Geräusche, Liegen, Aufwachen. <a class="hh-link" href="/pages/schlafratgeber">Zum Ratgeber</a></span></li>
      <li>{% render 'hh-icon', name: 'check' %}<span><strong>Auch „nicht geeignet für“</strong>Bei jedem Produkt steht, wofür es nicht gedacht ist.</span></li>
      <li>{% render 'hh-icon', name: 'truck' %}<span><strong>Lieferdatum vorab</strong>Steht bei jedem Produkt direkt am Kaufbutton.</span></li>
      <li>{% render 'hh-icon', name: 'return' %}<span><strong>Widerruf einfach erklärt</strong><a class="hh-link" href="/pages/rueckgabe-widerruf">So funktioniert es</a></span></li>
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "NW Fakten",
  "class": "hh-section",
  "settings": [
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "NW Fakten" }]
}
{% endschema %}
