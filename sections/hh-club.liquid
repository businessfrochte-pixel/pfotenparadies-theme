{%- comment -%}
  PfotenParadies Club (JARVIS, 19.10.2026). Zweck: E-Mail-Liste als wichtigster eigener Kanal – exklusiv statt „Newsletter“.
  Angebot (BERECHNUNG 18.10.2026): 5 € Willkommensvorteil ab 59 € Bestellwert hält jeden Artikel ≥ 25 % DB.
  Versprechen nur, was organisatorisch gehalten wird: Code + Willkommensmail (Shopify E-Mail/Flow) und „48 Stunden früher“ sind Eigentümer-Aktionen vor Start.
  Einblendung: dezentes Seitenfenster nach 45 s oder 55 % Scrolltiefe, nie auf Warenkorb/Kasse, höchstens alle 14 Tage, schließbar mit Esc.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- capture form_inner -%}
  <input type="hidden" name="contact[tags]" value="newsletter,club,shop-hund">
  <label class="hh-club__label" for="FIELD_ID">Deine E-Mail-Adresse</label>
  <div class="hh-club__row">
    <input id="FIELD_ID" class="hh-club__input" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="name@beispiel.de">
    <button class="hh-club__btn" type="submit">{{ s.button_label | escape }}</button>
  </div>
  <p class="hh-club__legal">Kostenlos, jederzeit mit einem Klick abmeldbar. Du bekommst zuerst eine E-Mail zur Bestätigung. Details in der <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Datenschutzerklärung</a>.</p>
{%- endcapture -%}

<section id="pfoten-club" class="hh hh-club" aria-labelledby="hh-club-title">
  <div class="hh-club__inner">
    <div class="hh-club__copy">
      <p class="hh-club__kicker">{% render 'hh-icon', name: 'paw' %}<span>{{ s.kicker | escape }}</span></p>
      <h2 id="hh-club-title" class="hh-club__title">{{ s.heading | escape }}</h2>
      <div class="hh-club__lead">{{ s.text }}</div>
      <ul class="hh-club__perks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="hh-club__perk-icon">{% render 'hh-icon', name: block.settings.icon %}</span>
            <span><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="hh-club__panel">
      <div class="hh-club__card" aria-hidden="true">
        <span class="hh-club__card-glow"></span>
        <span class="hh-club__card-top">{% render 'hh-wordmark' %}</span>
        <span class="hh-club__card-name">Club</span>
        <span class="hh-club__card-line">Mitgliedskarte</span>
      </div>
      {%- form 'customer', id: 'hh-club-form', class: 'hh-club__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="hh-club__ok" role="status"><strong>Willkommen im Club.</strong> Bitte bestätige deine Anmeldung über den Link in deinem Postfach.</p>
        {%- else -%}
          {{ form_inner | replace: 'FIELD_ID', 'hh-club-email' }}
          {%- if form.errors -%}<p class="hh-club__err" role="alert">Bitte prüfe deine E-Mail-Adresse.</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- if s.flyout -%}
  <aside class="hh-fly" id="hh-fly" hidden aria-labelledby="hh-fly-title" data-delay="{{ s.flyout_delay }}" data-pause-days="{{ s.flyout_pause_days }}">
    <button class="hh-fly__close" type="button" aria-label="Hinweis schließen" data-hh-fly-close>{% render 'hh-icon', name: 'close' %}</button>
    <p class="hh-fly__kicker">{% render 'hh-icon', name: 'paw' %}<span>{{ s.kicker | escape }}</span></p>
    <h2 id="hh-fly-title" class="hh-fly__title">{{ s.flyout_heading | escape }}</h2>
    <p class="hh-fly__text">{{ s.flyout_text | escape }}</p>
    {%- form 'customer', id: 'hh-club-fly', class: 'hh-club__form hh-fly__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="hh-club__ok" role="status"><strong>Willkommen im Club.</strong> Bitte bestätige deine Anmeldung in deinem Postfach.</p>
      {%- else -%}
        {{ form_inner | replace: 'FIELD_ID', 'hh-fly-email' }}
      {%- endif -%}
    {%- endform -%}
  </aside>
  <script>
    (function () {
      var fly = document.getElementById('hh-fly');
      if (!fly) return;
      var path = location.pathname;
      if (/^\/(cart|checkout|account)/.test(path) || location.hash === '#pfoten-club') return;
      var KEY = 'hh-club-fly', pause = (+fly.dataset.pauseDays || 14) * 864e5, now = Date.now(), last = 0;
      try { last = +localStorage.getItem(KEY) || 0; } catch (e) {}
      if (now - last < pause) return;
      var shown = false, lastFocus = null;
      function remember() { try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} }
      function show() {
        if (shown) return; shown = true;
        var club = document.getElementById('pfoten-club');
        if (club && club.getBoundingClientRect().top < innerHeight) return;
        lastFocus = document.activeElement;
        fly.hidden = false; requestAnimationFrame(function () { fly.classList.add('is-open'); });
        remember();
      }
      function hide() { fly.classList.remove('is-open'); setTimeout(function () { fly.hidden = true; }, 220); if (lastFocus && lastFocus.focus) lastFocus.focus(); }
      fly.querySelector('[data-hh-fly-close]').addEventListener('click', hide);
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !fly.hidden) hide(); });
      setTimeout(show, (+fly.dataset.delay || 45) * 1000);
      function onS(e) {
        var el = e.target === document ? document.documentElement : e.target;
        if (!el || !el.scrollHeight || el.scrollHeight <= innerHeight) return;
        if ((el.scrollTop + el.clientHeight) / el.scrollHeight > .55) { document.removeEventListener('scroll', onS, true); show(); }
      }
      document.addEventListener('scroll', onS, { capture: true, passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "PP Club (E-Mail)",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kurzzeile", "default": "PfotenParadies Club" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Für alle, die ihren Hund ein bisschen besser kennen als andere." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Werde Mitglied und bekomm, was nicht im Shop steht.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Mitglied werden" },
    { "type": "header", "content": "Seitenfenster" },
    { "type": "checkbox", "id": "flyout", "label": "Dezentes Seitenfenster zeigen", "default": true },
    { "type": "range", "id": "flyout_delay", "label": "Nach Sekunden", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 45 },
    { "type": "range", "id": "flyout_pause_days", "label": "Pause nach Anzeige", "min": 3, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "text", "id": "flyout_heading", "label": "Seitenfenster: Überschrift", "default": "5 € für deine erste Nacht mit uns" },
    { "type": "text", "id": "flyout_text", "label": "Seitenfenster: Text", "default": "Tritt dem Club bei: Willkommensvorteil ab 59 €, neue Schlafhelfer 48 Stunden früher und ein Schlafbrief im Monat." }
  ],
  "blocks": [
    { "type": "perk", "name": "Vorteil", "settings": [
      { "type": "select", "id": "icon", "label": "Symbol", "default": "paw", "options": [
        { "value": "paw", "label": "Pfote" }, { "value": "gift", "label": "Geschenk" }, { "value": "clock", "label": "Uhr" }, { "value": "mail", "label": "Brief" }, { "value": "check", "label": "Haken" } ] },
      { "type": "text", "id": "title", "label": "Titel" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "PP Club (E-Mail)" }]
}
{% endschema %}
