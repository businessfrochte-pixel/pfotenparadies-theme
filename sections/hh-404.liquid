{%- comment -%} PfotenParadies – Seite nicht gefunden (JARVIS). Zweck: Niemand landet in einer Sackgasse. {%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-empty" aria-labelledby="hh-404-title">
    <p class="hh-404__code">Fehler 404</p>
    <h1 id="hh-404-title" class="hh-h2">{{ section.settings.heading | escape }}</h1>
    <div class="hh-lead">{{ section.settings.text }}</div>
    <form class="hh-search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="hh-404-q">Suche</label>
      <input id="hh-404-q" type="search" name="q" placeholder="Wonach suchst du? z. B. Hundebett" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="hh-btn" type="submit">Suchen</button>
    </form>
    <ul class="hh-empty__links" aria-label="Bereiche">
      {%- for link in linklists['footer-sortiment'].links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
    </ul>
  </section>
</div>
{% schema %}
{
  "name": "PP Nicht gefunden",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Diese Seite gibt es nicht (mehr)." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Vielleicht hat sich der Link geändert. Such direkt nach dem, was du brauchst, oder stöbere in einem Bereich.</p>" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
