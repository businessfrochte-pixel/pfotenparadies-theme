{%- comment -%}
  PfotenParadies – Einstieg (JARVIS, v15, Gestaltung nach Entwurf v5). Fachshop-Einstieg [F1]:
  links Kundenwunsch, Angebot und Hauptaktion; rechts wenige Bedarfseinstiege mit Anwendungsszene [F5].
  Mit Hauptmotiv (Mensch und Hund im Alltag, [F2]) rückt das Bild nach rechts und die Bedarfseinstiege unter den Text.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'hh-hero-' | append: section.id
  assign has_photo = false
  if s.image != blank
    assign has_photo = true
  endif
-%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: s %}">
  <section class="hh hh-entry{% if has_photo %} hh-entry--photo{% endif %}" aria-labelledby="{{ heading_id }}">
    <div class="hh-entry__copy">
      <h1 id="{{ heading_id }}" class="hh-entry__title">{{ s.heading | escape }}</h1>
      {%- if s.text != blank -%}<div class="hh-lead hh-entry__lead">{{ s.text }}</div>{%- endif -%}
      <div class="hh-entry__actions">
        {%- if s.button_label != blank -%}
          <a class="hh-btn" href="{{ s.button_link | default: '/collections/schlafhelfer' }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="hh-link" href="{{ s.link_url | default: '/pages/schlafratgeber' }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if s.service_note != blank -%}<p class="hh-entry__service">{% render 'hh-icon', name: 'chat' %}<span>{{ s.service_note }}</span></p>{%- endif -%}
    </div>
    {%- if has_photo -%}
      <figure class="hh-entry__photo">
        <picture>
          {%- if s.image_mobile != blank -%}
            <source media="(max-width: 899px)" srcset="{{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
          {%- endif -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 45vw, 100vw', widths: '600, 900, 1200, 1400', alt: s.image.alt }}
        </picture>
      </figure>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <nav class="hh-entry__needs" aria-labelledby="{{ heading_id }}-needs">
        <p id="{{ heading_id }}-needs" class="hh-entry__needs-title">{{ s.needs_title | escape }}</p>
        <ul>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <a class="hh-need{% if b.image == blank %} hh-need--icon{% endif %}" href="{{ b.link | default: '/collections/schlafhelfer' }}">
                <span class="hh-need__media">
                  {%- if b.image != blank -%}
                    {{ b.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'eager', width: 120, height: 120, alt: '' }}
                  {%- else -%}
                    {% render 'hh-icon', name: b.icon %}
                  {%- endif -%}
                </span>
                <span class="hh-need__text">
                  <span class="hh-need__title">{{ b.text | escape }}</span>
                  {%- if b.sub != blank -%}<span class="hh-need__sub">{{ b.sub | escape }}</span>{%- endif -%}
                </span>
                <span class="hh-need__go">{% render 'hh-icon', name: 'arrow' %}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        {%- if s.draft_note != blank -%}<p class="hh-entry__note">{{ s.draft_note | escape }}</p>{%- endif -%}
      </nav>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "PP Einstieg",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift (Kundenwunsch, kurz)", "default": "Für den Alltag mit Hund – in der Größe, die wirklich passt." },
    { "type": "richtext", "id": "text", "label": "Unterzeile (Angebot und Mehrwert)", "default": "<p>Betten, Autoschutz, Pfotenpflege und Beschäftigung – bei jedem Produkt mit genauen Maßen in cm. Unsicher bei der Größe? Wir beraten dich, bevor du bestellst.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Sortiment ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "text", "id": "link_label", "label": "Zweiter Link", "default": "Hund richtig messen" },
    { "type": "url", "id": "link_url", "label": "Zweiter Link – Ziel" },
    { "type": "inline_richtext", "id": "service_note", "label": "Kleiner Servicehinweis", "default": "Unsicher bei der Auswahl? <a href=\"/pages/contact\">Wir helfen dir vor dem Kauf.</a>" },
    { "type": "header", "content": "Hauptmotiv" },
    { "type": "image_picker", "id": "image", "label": "Hauptmotiv (optional)", "info": "Echtes Foto: Mensch und Hund im Alltag mit einem unserer Produkte. Bildrechte klären. Mit Motiv stehen die Bedarfseinstiege unter dem Text." },
    { "type": "image_picker", "id": "image_mobile", "label": "Hauptmotiv mobil (eigener Ausschnitt)" },
    { "type": "header", "content": "Bedarfseinstiege" },
    { "type": "text", "id": "needs_title", "label": "Überschrift der Einstiege", "default": "Wobei können wir helfen?" },
    { "type": "text", "id": "draft_note", "label": "Hinweis zu Entwurfsbildern", "default": "Abbildungen: Entwurfsdarstellungen", "info": "Leeren, sobald echte Produktfotos eingesetzt sind." },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Bedarf",
      "settings": [
        { "type": "text", "id": "text", "label": "Situation aus Kundensicht" },
        { "type": "text", "id": "sub", "label": "Konkretes Angebot" },
        { "type": "url", "id": "link", "label": "Ziel (passende Auswahl)" },
        { "type": "image_picker", "id": "image", "label": "Anwendungsszene" },
        { "type": "select", "id": "icon", "label": "Symbol (ohne Bild)", "default": "gift", "options": [
          { "value": "gift", "label": "Geschenk" }, { "value": "bed", "label": "Bett" }, { "value": "car", "label": "Auto" },
          { "value": "paw", "label": "Pfote" }, { "value": "toy", "label": "Spielzeug" }, { "value": "leash", "label": "Leine" },
          { "value": "bowl", "label": "Napf" }, { "value": "coat", "label": "Mantel" }, { "value": "training", "label": "Training" }
        ] }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "PP Einstieg" }]
}
{% endschema %}
