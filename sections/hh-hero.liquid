{%- comment -%}
  PfotenParadies – Einstieg (JARVIS). Zweck: In Sekunden zeigen, für wen, welcher Nutzen,
  wie es aussieht und was der nächste Schritt ist. Alle Inhalte im Theme-Editor pflegbar.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'hh-hero-' | append: section.id
-%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-hero" aria-labelledby="{{ heading_id }}">
    <div class="hh-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="hh-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h1 id="{{ heading_id }}" class="hh-hero__title">{{ s.heading }}</h1>
      {%- if s.text != blank -%}<div class="hh-lead">{{ s.text }}</div>{%- endif -%}
      <div class="hh-hero__actions">
        {%- if s.button_label != blank -%}
          <a class="hh-btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}{% render 'hh-icon', name: 'arrow' %}</a>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="hh-link" href="{{ s.link_url | default: '/pages/messhilfe' }}">{{ s.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    <figure class="hh-hero__media">
      {%- if s.image != blank -%}
        <picture>
          {%- if s.image_mobile != blank -%}
            <source media="(max-width: 899px)" srcset="{{ s.image_mobile | image_url: width: 900 }} 900w, {{ s.image_mobile | image_url: width: 1400 }} 1400w" sizes="100vw">
          {%- endif -%}
          {{ s.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 45vw, 100vw', widths: '600, 900, 1200, 1400', alt: s.image.alt }}
        </picture>
      {%- else -%}
        <img src="{{ 'hh-hero.svg' | asset_url }}" width="660" height="792" alt="Illustration: ein Hund liegt entspannt auf einem runden Hundebett im Wohnzimmer" fetchpriority="high" loading="eager" decoding="async" class="hh-hero__art">
      {%- endif -%}
      {%- if s.chip != blank -%}
        <figcaption class="hh-chip hh-hero__chip">{% render 'hh-icon', name: 'bed' %}{{ s.chip | escape }}</figcaption>
      {%- endif -%}
    </figure>
  </section>
</div>

{% schema %}
{
  "name": "PP Einstieg",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile über der Überschrift", "default": "Für den Alltag mit Hund" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Hundezubehör in der Größe, die wirklich passt." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ruheplätze, Autozubehör, Pflege und Beschäftigung – mit genauen Maßen und dem Lieferdatum schon vor dem Kauf. Unsicher bei der Größe? Wir beraten dich, bevor du bestellst.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Sortiment ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "text", "id": "link_label", "label": "Zweiter Link", "default": "Hund richtig messen" },
    { "type": "url", "id": "link_url", "label": "Zweiter Link – Ziel" },
    { "type": "header", "content": "Motiv" },
    { "type": "image_picker", "id": "image", "label": "Bild (Desktop)", "info": "Echtes Anwendungsfoto mit geklärten Bildrechten. Ohne Bild erscheint die Marken-Illustration." },
    { "type": "image_picker", "id": "image_mobile", "label": "Bild (Mobil, eigener Ausschnitt)", "info": "Optional – nur nötig, wenn der Desktop-Ausschnitt mobil nicht verständlich ist." },
    { "type": "text", "id": "chip", "label": "Maß-Hinweis auf dem Bild", "default": "Bei jedem Bett: Liegefläche in cm" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "PP Einstieg" }]
}
{% endschema %}
