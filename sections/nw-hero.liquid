{%- comment -%}
  Nachtwerk 2050 – Einstieg „Nachtvitrine“ (JARVIS, 20.10.2026, Premium E-Commerce Architect).
  Links: Kundenwunsch in drei Wörtern, ein Satz Angebot, eine Hauptaktion, ein zweiter Weg, eine Faktenzeile.
  Rechts: die „Nachtachse“ – Störquellen als Momente einer Nacht (Uhrzeit = Reihenfolge, deshalb geordnete Liste),
  jede mit einem echten Produktfoto im Lichtkasten und Link zur passenden Auswahl. Das Motiv sind die Produkte selbst – kein Ersatzbild.
  Unten: Horizontlinie (reines CSS).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'nw-vh-' | append: section.id
  assign facts = ''
  if s.facts != blank
    assign set_min = 0
    for sp in collections['schlaf-sets'].products
      if set_min == 0 or sp.price < set_min
        assign set_min = sp.price
      endif
    endfor
    assign set_min_text = set_min | money
    capture free_ship
      render 'hh-config', key: 'free_shipping'
    endcapture
    assign free_ship = free_ship | strip
    assign facts = s.facts | replace: '[SET_MIN]', set_min_text | replace: '[FREE_SHIP]', free_ship
  endif
  assign lines = s.heading | split: '. '
-%}
<div class="section-background"></div>
<div class="nw-vh-wrap">
  <section class="hh nw-vh" aria-labelledby="{{ heading_id }}">
    <div class="nw-vh__inner">
      <div class="nw-vh__copy">
        <h1 id="{{ heading_id }}" class="nw-vh__title">
          {%- for line in lines -%}
            <span class="nw-vh__line" style="--i: {{ forloop.index0 }}">{{ line | escape }}{% unless forloop.last %}.{% endunless %}</span>
          {%- endfor -%}
        </h1>
        {%- if s.text != blank -%}<div class="nw-vh__lead">{{ s.text }}</div>{%- endif -%}
        <div class="nw-vh__actions">
          {%- if s.button_label != blank -%}
            <a class="nw-cta" href="{{ s.button_link | default: '/collections/schlafhelfer' }}">{{ s.button_label | escape }}</a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="nw-vh__link" href="{{ s.link_url | default: '/collections/schlaf-sets' }}">{{ s.link_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- if facts != '' -%}<p class="nw-vh__facts">{{ facts | escape }}</p>{%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <nav class="nw-axis" aria-labelledby="{{ heading_id }}-ax">
          <p id="{{ heading_id }}-ax" class="nw-axis__head">{{ s.needs_title | escape }}</p>
          <ol class="nw-axis__list" role="list">
            {%- for block in section.blocks -%}
              {%- assign b = block.settings -%}
              <li class="nw-axis__stop" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <a class="nw-axis__link" href="{{ b.link | default: '/collections/schlafhelfer' }}">
                  {%- if b.time != blank -%}<span class="nw-axis__time">{{ b.time | escape }}</span>{%- endif -%}
                  <span class="nw-axis__text">
                    <span class="nw-axis__title">{{ b.text | escape }}</span>
                    {%- if b.sub != blank -%}<span class="nw-axis__sub">{{ b.sub | escape }}</span>{%- endif -%}
                  </span>
                  <span class="nw-axis__box nw-lb" aria-hidden="true">
                    {%- if b.product != blank and b.product.featured_image -%}
                      {{ b.product.featured_image | image_url: width: 300 | image_tag: loading: 'eager', widths: '160, 240, 300', sizes: '(min-width: 990px) 96px, 72px', alt: '' }}
                    {%- else -%}
                      {% render 'hh-icon', name: b.icon %}
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ol>
        </nav>
      {%- endif -%}
    </div>
    <div class="nw-vh__horizon" aria-hidden="true"></div>
  </section>
</div>

{% schema %}
{
  "name": "NW Einstieg Nachtvitrine",
  "class": "hh-section nw-section nw-section--hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "info": "Sätze mit Punkt werden je in eine eigene Zeile gesetzt.", "default": "Dunkel. Still. Bequem." },
    { "type": "richtext", "id": "text", "label": "Unterzeile (ein Satz)", "default": "<p>Schlafhelfer gegen Licht, Lärm und unbequemes Liegen – ausgewählt nach dem, was dich nachts weckt.</p>" },
    { "type": "text", "id": "button_label", "label": "Haupt-Button", "default": "Schlafhelfer ansehen" },
    { "type": "url", "id": "button_link", "label": "Haupt-Button – Ziel" },
    { "type": "text", "id": "link_label", "label": "Zweiter Weg (untergeordnet)", "default": "Sets ansehen" },
    { "type": "url", "id": "link_url", "label": "Zweiter Weg – Ziel" },
    { "type": "text", "id": "facts", "label": "Faktenzeile", "info": "[SET_MIN] = günstigstes Set, [FREE_SHIP] = Gratisversand-Schwelle. Höchstens zwei Fakten.", "default": "Versand kostenlos ab [FREE_SHIP] · Sets ab [SET_MIN]" },
    { "type": "header", "content": "Nachtachse" },
    { "type": "text", "id": "needs_title", "label": "Überschrift der Nachtachse", "default": "Was stört deine Nacht?" }
  ],
  "blocks": [
    {
      "type": "stoerer",
      "name": "Moment der Nacht",
      "settings": [
        { "type": "text", "id": "time", "label": "Uhrzeit (Beispiel)", "default": "22:40" },
        { "type": "text", "id": "text", "label": "Störquelle", "default": "Licht" },
        { "type": "text", "id": "sub", "label": "Situation aus Kundensicht" },
        { "type": "url", "id": "link", "label": "Ziel (passende Auswahl)" },
        { "type": "product", "id": "product", "label": "Produkt im Lichtkasten", "info": "Echtes Produktfoto. Ohne Produkt erscheint das Symbol." },
        { "type": "select", "id": "icon", "label": "Symbol (Ersatz)", "default": "light", "options": [
          { "value": "light", "label": "Licht" }, { "value": "sound", "label": "Geräusche" }, { "value": "neck", "label": "Nacken/Kissen" },
          { "value": "sunrise", "label": "Aufwachen" }, { "value": "ear", "label": "Ohr" }, { "value": "moon", "label": "Mond" }, { "value": "layers", "label": "Decke" } ] }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "NW Einstieg Nachtvitrine" }]
}
{% endschema %}
