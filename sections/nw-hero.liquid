{%- comment -%}
  Nachtwerk – Einstieg (JARVIS, 18.10.2026). Kuratierter Fachshop nach Störquelle.
  Links: für wen, welcher Nutzen, nächster Schritt. Rechts: Hauptprodukt im Lampenlicht.
  Unten: vier Einstiege nach Störquelle (Licht, Geräusche, Nacken, Aufwachen) – jeweils eigene Auswahl.
  Motiv kommt aus dem gewählten Produkt (geprüfte Produktbilder), kein Deko-Bild.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'nw-hero-' | append: section.id
  assign p = s.product
  assign media = blank
  if p != blank
    assign idx = s.media_index | minus: 1
    assign media = p.media[idx] | default: p.featured_media
  endif
-%}
<div class="section-background"></div>
<div class="nw-hero-wrap spacing-style" style="{% render 'spacing-padding', settings: s %}">
  <section class="hh nw-hero" aria-labelledby="{{ heading_id }}">
    <div class="nw-hero__inner">
      <div class="nw-hero__copy">
        {%- if s.kicker != blank -%}<p class="nw-hero__kicker">{{ s.kicker | escape }}</p>{%- endif -%}
        <h1 id="{{ heading_id }}" class="nw-hero__title">{{ s.heading | escape }}</h1>
        {%- if s.text != blank -%}<div class="nw-hero__lead">{{ s.text }}</div>{%- endif -%}
        <div class="nw-hero__actions">
          {%- if s.button_label != blank -%}
            <a class="hh-btn nw-btn--lamp" href="{{ s.button_link | default: '/collections/schlafhelfer' }}">{{ s.button_label | escape }}{% render 'hh-icon', name: 'arrow' %}</a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a class="nw-hero__link" href="{{ s.link_url | default: '#nw-stoerer' }}">{{ s.link_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
      {%- if media != blank -%}
        <figure class="nw-hero__media">
          <span class="nw-hero__glow" aria-hidden="true"></span>
          <a class="nw-hero__frame" href="{{ p.url }}" aria-label="{{ p.title | escape }} ansehen">
            {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 40vw, 90vw', widths: '500, 800, 1000, 1200', alt: media.alt | default: p.title }}
          </a>
          <figcaption class="nw-hero__cap">
            <a href="{{ p.url }}"><span>{{ p.title | escape }}</span><span class="hh-tnum">ab {{ p.price_min | money }}</span></a>
          </figcaption>
        </figure>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav id="nw-stoerer" class="nw-stoerer" aria-labelledby="{{ heading_id }}-st">
        <h2 id="{{ heading_id }}-st" class="nw-stoerer__title">{{ s.needs_title | escape }}</h2>
        <ul class="nw-stoerer__list">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <li {{ block.shopify_attributes }}>
              <a class="nw-st" href="{{ b.link | default: '/collections/schlafhelfer' }}">
                <span class="nw-st__icon">{% render 'hh-icon', name: b.icon %}</span>
                <span class="nw-st__text">
                  <span class="nw-st__title">{{ b.text | escape }}</span>
                  {%- if b.sub != blank -%}<span class="nw-st__sub">{{ b.sub | escape }}</span>{%- endif -%}
                </span>
                <span class="nw-st__go">{% render 'hh-icon', name: 'arrow' %}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "NW Einstieg (Nacht)",
  "class": "hh-section nw-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kurzzeile über der Überschrift (optional)" },
    { "type": "text", "id": "heading", "label": "Überschrift (Kundenwunsch)", "default": "Schlaf ohne Störung" },
    { "type": "richtext", "id": "text", "label": "Unterzeile", "default": "<p>Hilfsmittel gegen Licht, Geräusche und unbequemes Liegen.</p>" },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Alle Schlafhelfer ansehen" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "text", "id": "link_label", "label": "Zweiter Link", "default": "Nach Störquelle wählen" },
    { "type": "url", "id": "link_url", "label": "Zweiter Link – Ziel" },
    { "type": "header", "content": "Motiv" },
    { "type": "product", "id": "product", "label": "Produkt im Lampenlicht" },
    { "type": "range", "id": "media_index", "label": "Welches Produktbild", "min": 1, "max": 10, "step": 1, "default": 1 },
    { "type": "header", "content": "Einstiege nach Störquelle" },
    { "type": "text", "id": "needs_title", "label": "Überschrift", "default": "Was stört deinen Schlaf?" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "stoerer",
      "name": "Störquelle",
      "settings": [
        { "type": "text", "id": "text", "label": "Störquelle", "default": "Licht" },
        { "type": "text", "id": "sub", "label": "Situation aus Kundensicht" },
        { "type": "url", "id": "link", "label": "Ziel (passende Auswahl)" },
        { "type": "select", "id": "icon", "label": "Symbol", "default": "light", "options": [
          { "value": "light", "label": "Licht" }, { "value": "sound", "label": "Geräusche" }, { "value": "neck", "label": "Nacken/Kissen" },
          { "value": "sunrise", "label": "Aufwachen" }, { "value": "ear", "label": "Ohr" }, { "value": "moon", "label": "Mond" }, { "value": "layers", "label": "Decke" } ] }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "NW Einstieg (Nacht)" }]
}
{% endschema %}
