{%- comment -%}
  Nachtwerk – Sets (JARVIS, 19.10.2026; v3 nach Designkritik: gleich aufgebaute, vergleichbare Karten statt Bento-Mischung).
  Feste Reihenfolge je Karte: Bild der enthaltenen Produkte (einheitliche Kacheln, ganzes Produkt sichtbar) → Name → Situation → Inhalt → Preis mit zurückhaltender Einzelpreis-Angabe.
  Keine Spar-Badges (wirkt wie Aktionsware).
  Zweck: Warenkorbwert erhöhen mit echtem Nutzen (mehrere Störquellen auf einmal) und ehrlicher Ersparnis
  („einzeln X · du sparst Y“ live aus den Einzelpreisen der Set-Varianten, nur wenn alle Teile lieferbar; kein Streichpreis/compare_at_price). Erstes Set groß, die übrigen kleiner.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign coll = s.collection -%}
{%- if coll != blank and coll.products_count > 0 -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: s %}">
  <section class="hh nw-sets" aria-labelledby="nw-sets-{{ section.id }}">
    <div class="nw-sets__head">
      <div>
        <h2 id="nw-sets-{{ section.id }}" class="nw-h2">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<p class="nw-sets__lead">{{ s.text | escape }}</p>{%- endif -%}
      </div>
      <a class="hh-link" href="{{ coll.url }}">Alle Sets</a>
    </div>
    <ul class="nw-sets__grid">
      {%- for set in coll.products limit: 4 -%}
        {%- assign items = set.metafields.custom.set_items.value -%}
        {%- assign single = 0 -%}
        {%- assign all_avail = true -%}
        {%- for v in set.metafields.custom.set_variants.value -%}
          {%- assign single = single | plus: v.price -%}
          {%- unless v.available -%}{%- assign all_avail = false -%}{%- endunless -%}
        {%- endfor -%}
        {%- assign save = single | minus: set.price -%}
        {%- unless all_avail -%}{%- assign save = 0 -%}{%- endunless -%}
        <li class="nw-set">
          <a class="nw-set__link" href="{{ set.url }}">
            <span class="nw-set__media">{% render 'nw-set-stage', product: set, size: 'card' %}</span>
            <span class="nw-set__body">
              <span class="nw-set__name">{{ set.title | split: '„' | last | split: '“' | first | escape }}</span>
              {%- assign nutzen = set.metafields.custom.set_nutzen.value -%}
              {%- if nutzen != blank -%}<span class="nw-set__why">{{ nutzen | escape }}</span>{%- endif -%}
              <span class="nw-set__what">{% for it in items %}{{ it.title | split: ' mit ' | first | split: ',' | first }}{% unless forloop.last %} + {% endunless %}{% endfor %}</span>
              <span class="nw-set__price"><strong class="hh-tnum">{{ set.price | money }}</strong>{%- if save > 0 -%}<span class="hh-tnum">du sparst {{ save | money }} (einzeln {{ single | money }})</span>{%- endif -%}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
</div>
{%- endif -%}
{% schema %}
{
  "name": "NW Sets",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Mehrere Störquellen, ein Set – günstiger als einzeln" },
    { "type": "text", "id": "text", "label": "Text", "default": "Sets gegen mehrere Störquellen – günstiger als einzeln." },
    { "type": "collection", "id": "collection", "label": "Sammlung mit Sets" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "NW Sets" }]
}
{% endschema %}
