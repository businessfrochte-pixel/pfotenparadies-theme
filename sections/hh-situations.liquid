{%- comment -%}
  PfotenParadies – Einstieg nach Anlass (JARVIS). Zweck: Besucher finden über ihre Situation statt über Produktnamen.
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <nav class="hh hh-sit hh-reveal" aria-labelledby="hh-sit-{{ section.id }}">
    <h2 id="hh-sit-{{ section.id }}" class="hh-eyebrow hh-sit__title">{{ section.settings.heading | escape }}</h2>
    <ul class="hh-sit__grid">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="hh-sit__item" href="{{ block.settings.link | default: '/collections/all' }}">
            <span class="hh-sit__icon">{% render 'hh-icon', name: block.settings.icon %}</span>
            <span class="hh-sit__text">{{ block.settings.text | escape }}</span>
            <span class="hh-sit__go"><span>{{ block.settings.cta | escape }}</span>{% render 'hh-icon', name: 'arrow' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

{% schema %}
{
  "name": "PP Situationen",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wobei können wir helfen?" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "situation",
      "name": "Situation",
      "settings": [
        { "type": "select", "id": "icon", "label": "Symbol", "default": "bed", "options": [
          { "value": "bed", "label": "Bett" }, { "value": "car", "label": "Auto" }, { "value": "paw", "label": "Pfote" },
          { "value": "toy", "label": "Spielzeug" }, { "value": "leash", "label": "Leine" }, { "value": "bowl", "label": "Napf" },
          { "value": "coat", "label": "Mantel" }, { "value": "training", "label": "Training" } ] },
        { "type": "text", "id": "text", "label": "Situation", "default": "Mein Hund braucht einen besseren Schlafplatz" },
        { "type": "text", "id": "cta", "label": "Link-Text", "default": "Passende Betten" },
        { "type": "url", "id": "link", "label": "Ziel" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "PP Situationen" }]
}
{% endschema %}
