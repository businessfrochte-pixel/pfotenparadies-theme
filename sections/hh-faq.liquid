{%- comment -%}
  PfotenParadies – Häufige Fragen (JARVIS). Inhalte zentral in snippets/hh-faq-list.liquid (eine Quelle für Startseite und FAQ-Seite).
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <div class="hh-reveal">{% render 'hh-faq-list', short: section.settings.short %}</div>
</div>

{% schema %}
{
  "name": "PP Häufige Fragen",
  "class": "hh-section",
  "settings": [
    { "type": "checkbox", "id": "short", "label": "Kurzfassung (5 Fragen + Link)", "default": true },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "PP Häufige Fragen" }]
}
{% endschema %}
