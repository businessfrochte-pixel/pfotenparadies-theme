{%- comment -%}
  Nachtwerk Club (JARVIS, 19.10.2026). Zweck: E-Mail-Liste als wichtigster eigener Kanal – exklusiv statt „Newsletter“.
  Angebot (BERECHNUNG 18.10.2026): 5 € Willkommensvorteil ab 59 € Bestellwert hält jeden Artikel ≥ 25 % DB.
  Versprechen nur, was organisatorisch gehalten wird: Code + Willkommensmail (Shopify E-Mail/Flow) und „48 Stunden früher“ sind Eigentümer-Aktionen vor Start.
  Einblendung: dezentes Seitenfenster nach 45 s oder 55 % Scrolltiefe, nie auf Warenkorb/Kasse und mobil nie auf Produktseiten, höchstens alle 14 Tage, schließbar mit Esc.
  Nur einmal je Seite einbinden (feste IDs, kein Preset) – sitzt in der Fußzeilen-Gruppe.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- capture form_inner -%}
  <input type="hidden" name="contact[tags]" value="newsletter,club,shop-schlaf">
  <label class="nw-club__label" for="FIELD_ID">Deine E-Mail-Adresse</label>
  <div class="nw-club__row">
    <input id="FIELD_ID" class="nw-club__input" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required placeholder="name@beispiel.de">
    <button class="nw-club__btn" type="submit">{{ s.button_label | escape }}</button>
  </div>
  <p class="nw-club__legal">Kostenlos, jederzeit mit einem Klick abmeldbar. Du bekommst zuerst eine E-Mail zur Bestätigung. {% if s.conditions != blank %}{{ s.conditions | escape }} {% endif %}Details in der <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Datenschutzerklärung</a>.</p>
{%- endcapture -%}

<section id="nachtwerk-club" class="hh nw-club" aria-labelledby="nw-club-title">
  <div class="nw-club__inner">
    <div class="nw-club__copy">
      <p class="nw-club__kicker">{% render 'hh-icon', name: 'moon' %}<span>{{ s.kicker | escape }}</span></p>
      <h2 id="nw-club-title" class="nw-club__title">{{ s.heading | escape }}</h2>
      <div class="nw-club__lead">{{ s.text }}</div>
      <ul class="nw-club__perks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="nw-club__perk-icon">{% render 'hh-icon', name: block.settings.icon %}</span>
            <span><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="nw-club__panel">
      <div class="nw-club__card" aria-hidden="true">
        <span class="nw-club__card-glow"></span>
        <span class="nw-club__card-top">{% render 'hh-wordmark' %}</span>
        <span class="nw-club__card-name">Club</span>
        <span class="nw-club__card-line">Mitgliedskarte</span>
      </div>
      {%- form 'customer', id: 'nw-club-form', class: 'nw-club__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="nw-club__ok" role="status"><strong>Fast geschafft.</strong> Bitte bestätige deine Anmeldung über den Link in deinem Postfach – danach bist du im Club und bekommst deinen Willkommensvorteil.</p>
        {%- else -%}
          {{ form_inner | replace: 'FIELD_ID', 'nw-club-email' }}
          {%- if form.errors -%}<p class="nw-club__err" role="alert">Bitte prüfe deine E-Mail-Adresse.</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- if s.flyout -%}
  <aside class="nw-fly" id="nw-fly" hidden role="dialog" aria-modal="false" aria-labelledby="nw-fly-title" data-delay="{{ s.flyout_delay }}" data-pause-days="{{ s.flyout_pause_days }}">
    <button class="nw-fly__close" type="button" aria-label="Hinweis schließen" data-nw-fly-close>{% render 'hh-icon', name: 'close' %}</button>
    <p class="nw-fly__kicker">{% render 'hh-icon', name: 'moon' %}<span>{{ s.kicker | escape }}</span></p>
    <h2 id="nw-fly-title" class="nw-fly__title">{{ s.flyout_heading | escape }}</h2>
    <p class="nw-fly__text">{{ s.flyout_text | escape }}</p>
    {%- form 'customer', id: 'nw-club-fly', class: 'nw-club__form nw-fly__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="nw-club__ok" role="status"><strong>Fast geschafft.</strong> Bitte bestätige deine Anmeldung über den Link in deinem Postfach.</p>
      {%- else -%}
        {{ form_inner | replace: 'FIELD_ID', 'nw-fly-email' }}
        {%- if form.errors -%}<p class="nw-club__err" role="alert">Bitte prüfe deine E-Mail-Adresse.</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </aside>
  <script>
    (function () {
      var fly = document.getElementById('nw-fly');
      if (!fly) return;
      var KEY = 'nw-club-fly', SENT = 'nw-club-fly-sent', pause = (+fly.dataset.pauseDays || 14) * 864e5;
      var form = fly.querySelector('form');
      if (form) form.addEventListener('submit', function () { try { sessionStorage.setItem(SENT, '1'); } catch (e) {} });
      var sent = false; try { sent = sessionStorage.getItem(SENT) === '1'; sessionStorage.removeItem(SENT); } catch (e) {}
      var lastFocus = null;
      function open(focusIt) {
        lastFocus = document.activeElement;
        fly.hidden = false; requestAnimationFrame(function () { fly.classList.add('is-open'); });
        try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
        if (focusIt) { var t = fly.querySelector('.nw-club__ok, .nw-club__err, input[type=email]'); if (t) { t.setAttribute('tabindex', '-1'); t.focus(); } }
      }
      function hide() {
        var hadFocus = fly.contains(document.activeElement);
        fly.classList.remove('is-open'); setTimeout(function () { fly.hidden = true; }, 220);
        if (hadFocus && lastFocus && lastFocus.focus && document.contains(lastFocus)) lastFocus.focus();
      }
      fly.querySelector('[data-nw-fly-close]').addEventListener('click', hide);
      fly.addEventListener('keydown', function (e) { if (e.key === 'Escape') { e.stopPropagation(); hide(); } });
      // Nach dem Absenden über das Seitenfenster: Ergebnis (Bestätigung oder Fehler) dort zeigen.
      if (sent && /customer_posted=true/.test(location.search + location.hash) || sent && fly.querySelector('.nw-club__err')) { open(true); return; }
      var path = location.pathname;
      if (/\/(cart|checkout|account)(\/|$)/.test(path) || location.hash === '#nachtwerk-club') return;
      if (innerWidth < 600 && /\/products\//.test(path)) return; // mobil nie über dem Kaufbereich
      var last = 0; try { last = +localStorage.getItem(KEY) || 0; } catch (e) {}
      if (Date.now() - last < pause) return;
      var shown = false;
      function show() {
        if (shown) return; shown = true;
        var club = document.getElementById('nachtwerk-club');
        if (club && club.getBoundingClientRect().top < innerHeight) return;
        open(false);
      }
      setTimeout(show, (+fly.dataset.delay || 45) * 1000);
      function onS(e) {
        var el = e.target === document ? document.documentElement : e.target;
        if (!el || !el.scrollHeight || el.scrollHeight <= innerHeight) return;
        if ((el.scrollTop + el.clientHeight) / el.scrollHeight > .55) { document.removeEventListener('scroll', onS, true); show(); }
      }
      document.addEventListener('scroll', onS, { capture: true, passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "NW Club (E-Mail)",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kurzzeile", "default": "Nachtwerk Club" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Für Menschen, die ihre Nächte ernst nehmen." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Werde Mitglied und bekomm, was nicht im Shop steht.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Mitglied werden" },
    { "type": "text", "id": "conditions", "label": "Bedingungen des Willkommensvorteils", "default": "Willkommensvorteil: 5 € Rabatt ab 59 € Bestellwert, einmal pro Person, nicht mit anderen Codes kombinierbar." },
    { "type": "header", "content": "Seitenfenster" },
    { "type": "checkbox", "id": "flyout", "label": "Dezentes Seitenfenster zeigen", "default": true },
    { "type": "range", "id": "flyout_delay", "label": "Nach Sekunden", "min": 20, "max": 120, "step": 5, "unit": "s", "default": 45 },
    { "type": "range", "id": "flyout_pause_days", "label": "Pause nach Anzeige", "min": 3, "max": 60, "step": 1, "unit": "d", "default": 14 },
    { "type": "text", "id": "flyout_heading", "label": "Seitenfenster: Überschrift", "default": "5 € für deine erste Nacht mit uns" },
    { "type": "text", "id": "flyout_text", "label": "Seitenfenster: Text", "default": "Tritt dem Club bei: Willkommensvorteil ab 59 €, neue Schlafhelfer 48 Stunden früher und ein Schlafbrief im Monat." }
  ],
  "blocks": [
    { "type": "perk", "name": "Vorteil", "settings": [
      { "type": "select", "id": "icon", "label": "Symbol", "default": "moon", "options": [
        { "value": "moon", "label": "Mond" }, { "value": "gift", "label": "Geschenk" }, { "value": "clock", "label": "Uhr" }, { "value": "mail", "label": "Brief" }, { "value": "check", "label": "Haken" } ] },
      { "type": "text", "id": "title", "label": "Titel" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4
}
{% endschema %}
