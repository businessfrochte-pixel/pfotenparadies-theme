{%- comment -%}
  PfotenParadies – Bereiche (JARVIS). Zweck: Orientierung im Sortiment mit einem konkreten Merkmal pro Bereich.
{%- endcomment -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <section class="hh hh-cats hh-reveal" aria-labelledby="hh-cats-{{ section.id }}">
    <div class="hh-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="hh-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="hh-cats-{{ section.id }}" class="hh-h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="hh-link hh-link--arrow" href="{{ routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
    <ul class="hh-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title
          if title == blank and c != blank
            assign title = c.title
          endif
          assign url = '/collections/all'
          if c != blank
            assign url = c.url
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="hh-card" href="{{ url }}">
            <span class="hh-card__title">{{ title | escape }}</span>
            {%- if block.settings.subtitle != blank -%}<span class="hh-card__sub">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </section>
</div>

{% schema %}
{
  "name": "PP Bereiche",
  "class": "hh-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Sortiment" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Alle Bereiche" },
    { "type": "text", "id": "link_label", "label": "Link zu allen Produkten", "default": "Alle Produkte" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding-block-start", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Bereich",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "title", "label": "Titel (optional)" },
        { "type": "text", "id": "subtitle", "label": "Merkmal", "default": "Mit genauen Maßen" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "PP Bereiche" }]
}
{% endschema %}
