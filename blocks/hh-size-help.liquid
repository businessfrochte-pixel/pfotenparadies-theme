{%- comment -%}
  Zweck: Größenhilfe direkt bei der Auswahl. Quelle: Produktfeld custom.groessentabelle
  (erste Zeile = Spaltenüberschriften, Spalten mit | trennen, erste Spalte = Größe wie in der Variante).
  Die Zeile der gewählten Größe wird markiert (Server + sofort per JS).
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign raw = p.metafields.custom.groessentabelle.value
-%}
{%- if raw != blank -%}
  {%- liquid
    assign lines = raw | strip | newline_to_br | split: '<br />'
    assign head = lines.first | split: '|'
    assign opt_name = head.first | strip
    assign current = blank
    for o in p.options_with_values
      if o.name == opt_name
        assign current = o.selected_value
      endif
    endfor
    if current == blank
      assign opt_name = p.options_with_values.first.name
      assign current = p.options_with_values.first.selected_value
    endif
    assign current_summary = ''
  -%}
  <div class="hh hh-size" data-hh-size data-option="{{ opt_name | escape }}" {{ block.shopify_attributes }}>
    <div class="hh-size__head">
      <span class="hh-size__title">{{ block.settings.title | escape }}</span>
      <a class="hh-link" href="{{ block.settings.link | default: '/pages/messhilfe' }}">{{ block.settings.link_label | escape }}</a>
    </div>
    <div class="hh-size__scroll">
      <table>
        <thead><tr>{%- for h in head -%}<th scope="col">{{ h | strip | escape }}</th>{%- endfor -%}</tr></thead>
        <tbody>
          {%- for line in lines offset: 1 -%}
            {%- assign cells = line | split: '|' -%}
            {%- assign key = cells.first | strip -%}
            {%- if key == blank -%}{%- continue -%}{%- endif -%}
            {%- capture summary -%}{{ key }}:{% for c in cells offset: 1 %} {{ head[forloop.index] | strip }} {{ c | strip }}{% unless forloop.last %} ·{% endunless %}{% endfor %}{%- endcapture -%}
            {%- if key == current -%}{%- assign current_summary = summary -%}{%- endif -%}
            <tr data-value="{{ key | escape }}" data-summary="{{ summary | strip | escape }}"{% if key == current %} class="is-active"{% endif %}>
              {%- for c in cells -%}<td>{{ c | strip | escape }}</td>{%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    <p class="hh-size__hint"><span class="visually-hidden">Gewählt: </span><strong data-hh-size-current>{{ current_summary | strip | escape }}</strong>{% if p.metafields.custom.groessen_hinweis != blank %}<br>{{ p.metafields.custom.groessen_hinweis.value | escape }}{% endif %}</p>
  </div>
{%- endif -%}
{% schema %}
{ "name": "PP Größenhilfe", "tag": null, "settings": [
  { "type": "text", "id": "title", "label": "Überschrift", "default": "Welche Größe passt?" },
  { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Hund richtig messen" },
  { "type": "url", "id": "link", "label": "Link-Ziel" }
] }
{% endschema %}
