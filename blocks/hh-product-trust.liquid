{%- comment -%} Zweck: Lieferdatum, Kosten, Rückgabe und Hilfe direkt unter dem Kaufbutton. {%- endcomment -%}
{%- assign product = closest.product -%}
<div class="hh hh-ptrust" {{ block.shopify_attributes }}>
  {% render 'hh-eta', product: product %}
  <ul class="hh-ptrust__list">
    <li><span><strong>Versand in andere Länder</strong> – <a href="/pages/versand-lieferung">Länder und Kosten</a></span></li>
    <li><span>14 Tage gesetzliches Widerrufsrecht – <a href="/pages/rueckgabe-widerruf">so funktioniert es</a></span></li>
    <li><span><strong>Als Gast bestellen</strong> – ohne Kundenkonto</span></li>
  </ul>
  {% render 'hh-payment-icons' %}
  <p class="hh-ptrust__help">Fragen zum Artikel? <a href="/pages/contact?produkt={{ product.title | url_encode }}">Schreib uns</a> – Antwort {% render 'hh-config', key: 'reply_time' %}.</p>
</div>
{% schema %}
{ "name": "PP Lieferung & Service", "tag": null, "settings": [] }
{% endschema %}
