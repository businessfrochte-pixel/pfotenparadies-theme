    "hh_ruheplatz": {
      "type": "hh-guide",
      "blocks": {
        "chk_1": {
          "type": "check",
          "settings": {
            "label": "Streckt sich gern aus:",
            "text": "eher ein flaches Kissen oder eine Matte mit großer Liegefläche."
          }
        },
        "chk_2": {
          "type": "check",
          "settings": {
            "label": "Rollt sich ein und lehnt sich an:",
            "text": "eher ein Bett mit Rand."
          }
        },
        "chk_3": {
          "type": "check",
          "settings": {
            "label": "Älter oder steif:",
            "text": "auf einen niedrigen Einstieg achten."
          }
        },
        "stp_1": {
          "type": "step",
          "settings": {
            "text": "Miss deinen Hund im ausgestreckten Liegen – von der Nase bis zum Rutenansatz."
          }
        },
        "stp_2": {
          "type": "step",
          "settings": {
            "text": "Rechne 20 bis 30 cm dazu."
          }
        },
        "stp_3": {
          "type": "step",
          "settings": {
            "text": "Vergleiche mit der <strong>Liegefläche</strong> beim Bett – nicht mit dem Außenmaß."
          }
        }
      },
      "block_order": [
        "chk_1",
        "chk_2",
        "chk_3",
        "stp_1",
        "stp_2",
        "stp_3"
